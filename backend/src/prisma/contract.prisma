// use prisma-8

enum ProjectStatus {
  @@type("pg/text@1")

  DRAFT     = "draft"
  ACTIVE    = "active"
  COMPLETED = "completed"
  CANCELLED = "cancelled"
}

enum WithdrawalStatus {
  @@type("pg/text@1")

  CREATED            = "created"
  QUOTED             = "quoted"
  AWAITING_SIGNATURE = "awaiting_signature"
  SUBMITTED          = "submitted"
  PROCESSING         = "processing"
  PAID               = "paid"
  FAILED              = "failed"
  EXPIRED             = "expired"
  CANCELLED           = "cancelled"
}

enum LedgerAccountType {
  @@type("pg/text@1")

  EXTERNAL           = "external"
  ESCROW             = "escrow"
  FREELANCER_BALANCE = "freelancer_balance"
  PAYOUT_CLEARING    = "payout_clearing"
  PLATFORM_REVENUE   = "platform_revenue"
}

enum LedgerEntryDirection {
  @@type("pg/text@1")

  DEBIT  = "debit"
  CREDIT = "credit"
}

enum MilestoneStatus {
  @@type("pg/text@1")

  PENDING   = "pending"
  FUNDED    = "funded"
  SUBMITTED = "submitted"
  RELEASED  = "released"
  REFUNDED  = "refunded"
}
model User {
  id            Uuid    @id @default(uuid())
  name          String
  email         String  @unique
  passwordHash  String
  walletAddress String? @unique

  clientProjects     Project[] @relation("ProjectClient")
  freelancerProjects Project[] @relation("ProjectFreelancer")
  withdrawals        Withdrawal[]
  ledgerAccounts     LedgerAccount[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("users")
}

model Project {
  id          Uuid          @id @default(uuid())
  title       String
  description String?
  status      ProjectStatus @default(DRAFT)

  clientId Uuid
  client   User @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)

  freelancerId Uuid
  freelancer   User @relation("ProjectFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)

  milestones Milestone[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([clientId, status])
  @@index([freelancerId, status])

  @@map("projects")
}

model Milestone {
  id Uuid @id @default(uuid())

  projectId Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sequence    Int
  title       String
  description String?

  amountBaseUnits BigInt
  status          MilestoneStatus @default(PENDING)

  escrowAddress      String? @unique
  fundTxSignature    String? @unique
  submitTxSignature  String? @unique
  releaseTxSignature String? @unique
  refundTxSignature  String? @unique

  fundedAt    TimestamptzString?
  submittedAt TimestamptzString?
  releasedAt  TimestamptzString?

  confirmations EscrowConfirmation[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([projectId, sequence])
  @@index([projectId, status])

  @@map("milestones")
}

model EscrowConfirmation {
  id Uuid @id @default(uuid())

  milestoneId Uuid
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  action    String
  signature String @unique
  createdAt TimestamptzString @default(now())

  @@unique([milestoneId, action])
  @@map("escrow_confirmations")
}

model Withdrawal {
  id Uuid @id @default(uuid())

  userId Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  idempotencyKey String

  amountBaseUnits BigInt
  feeBaseUnits    BigInt @default(0)
  fiatAmountMinor BigInt
  asset          String @default("BRLP")
  fiatCurrency   String @default("BRL")

  pixKey        String
  walletAddress String

  provider String @default("pagfinance")

  providerQuoteReference String? @unique
  providerReference      String? @unique
  txSignature            String? @unique

  quoteExpiresAt TimestamptzString?

  status WithdrawalStatus @default(CREATED)

  failureCode   String?
  failureReason String?

  submittedAt TimestamptzString?
  paidAt      TimestamptzString?
  failedAt    TimestamptzString?
  expiredAt   TimestamptzString?
  cancelledAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([userId, status])
  @@index([status, createdAt])
  @@unique([userId, idempotencyKey])

  @@map("withdrawals")
}

model LedgerAccount {
  id Uuid @id @default(uuid())

  key   String            @unique
  type  LedgerAccountType
  asset String

  ownerUserId Uuid?
  ownerUser   User? @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  entries LedgerEntry[]

  createdAt TimestamptzString @default(now())

  @@index([ownerUserId, type, asset])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id Uuid @id @default(uuid())

  eventType      String
  idempotencyKey String @unique
  referenceType  String
  referenceId    Uuid
  description    String?

  entries LedgerEntry[]

  createdAt TimestamptzString @default(now())

  @@index([referenceType, referenceId])
  @@index([createdAt, id])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id Uuid @id @default(uuid())

  transactionId Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  accountId Uuid
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  direction       LedgerEntryDirection
  amountBaseUnits BigInt

  createdAt TimestamptzString @default(now())

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}
