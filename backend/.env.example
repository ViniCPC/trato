# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-bytes"
FRONTEND_URL="http://localhost:4200"
PORT=3000

# `mock` funciona sem RPC; `solana` exige as três variáveis seguintes.
ESCROW_DRIVER=mock
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_PROGRAM_ID="973yrLGt8Jro3ak66GxTyBXBYens5di54txDxJFGJNxG"
SOLANA_TOKEN_MINT=""
SOLANA_CLUSTER=devnet

# Somente desenvolvimento. Aceita o JSON da secret key ou o caminho do arquivo.
FAUCET_AUTHORITY_SECRET=""
