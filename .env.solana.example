# RPC e identidade usada para deploy, criação do mint e faucet. Nunca versione a chave.
SOLANA_RPC_URL=https://api.devnet.solana.com
DEPLOYER_KEYPAIR=C:/caminho/seguro/devnet-authority.json

# Config on-chain. FREELANCER_WALLET usa a autoridade por padrão.
FREELANCER_WALLET=
ESCROW_MAX_AMOUNT=1000
CLAIM_DELAY_SECONDS=300

# Opcional na primeira execução. O setup salva o mint criado em .devnet/trato.json.
BRLP_MINT=
TEST_WALLETS=
BRLP_TEST_BALANCE=100

# Backend
ESCROW_DRIVER=solana
SOLANA_PROGRAM_ID=5jqtbGSBvTACNYzjeWFsRnXLYFwZDMZ9qjV8Spt4jgqn
SOLANA_TOKEN_MINT=
SOLANA_CLUSTER=devnet
FAUCET_AUTHORITY_SECRET=C:/caminho/seguro/devnet-authority.json
